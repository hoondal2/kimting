spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/kimting
    username: postgres
    password: your_password_here
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    open-in-view: false
  jackson:
    serialization:
      write-dates-as-timestamps: false
    deserialization:
      fail-on-unknown-properties: false
  ai:
    vectorstore:
      pgvector:
        dimensions: 768
        distance-type: COSINE_DISTANCE
        initialize-schema: true
        index-type: HNSW
        schema-name: public
        table-name: vector_store
    openai:
      api-key: your-gemini-api-key-here   # https://aistudio.google.com → Get API key
      base-url: https://generativelanguage.googleapis.com/v1beta/openai
      chat:
        completions-path: /chat/completions
        options:
          model: gemini-1.5-flash           # 무료 티어. gemini-2.0-flash, gemini-1.5-pro 등으로 변경 가능
          max-tokens: 1024
          temperature: 0.1                 # 파싱용 기본값. 채팅은 ChatService에서 0.7로 오버라이드
      embedding:
        embeddings-path: /embeddings
        options:
          model: gemini-embedding-001       # outputDimensionality=768 적용, 무료 티어
    retry:
      max-attempts: 1   # 429 시 자동 재시도 비활성화 (무료 티어 quota 보호)
    mcp:
      server:
        name: kimting-mcp
        version: 1.0.0

# LLM 파서 설정
# provider: llm | rule-based
#   llm        - Google Gemini API 사용 (api-key 필요)
#   rule-based - LLM 없이 키워드/정규식으로 파싱 (API key 불필요)
kimting:
  parser:
    provider: llm
  jwt:
    # 최소 32자 이상의 랜덤 문자열 (운영 환경에서는 반드시 교체)
    secret: change-me-to-a-random-64-character-string-in-production-env
    expiration-ms: 86400000   # 24시간 (밀리초)
